+            // Quotation preview only. The server continues to store and validate the
+            // original RFQ quantity and supplier's offered unit price independently.
+            // Calculate in cent-thousandths: prices use centavos, quantities may
+            // have 3 decimal places. Avoid accumulating binary floating-point pesos.
+            const quoteLineMilleCents=line=>{
+                const raw=String(line.price??'').trim();
+                const qty=Number(line.quantity);
+                if(!/^\d+(?:\.\d{1,2})?$/.test(raw)||!Number.isFinite(qty)||qty<=0)return null;
+                const unitCents=Math.round(Number(raw)*100);
+                const qtyMillis=Math.round(qty*1000);
+                if(unitCents<=0||qtyMillis<=0||!Number.isSafeInteger(unitCents)||!Number.isSafeInteger(qtyMillis))return null;
+                const total=unitCents*qtyMillis;
+                return Number.isSafeInteger(total)?total:null;
+            };
+            const quotePreviewTotal=lines=>{
+                if(!lines.length)return null;
+                let sum=0;
+                for(const line of lines){
+                    const amount=quoteLineMilleCents(line);
+                    if(amount===null||!Number.isSafeInteger(sum+amount))return null;
+                    sum+=amount;
+                }
+                return sum;
+            };
+            const quotePreviewPeso=value=>value===null?'—':money(Math.round(value/1000)/100);
